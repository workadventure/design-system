{
    "name": "@workadventure/design-system",
    "version": "2.0.4",
    "description": "Tailwind Theme for WorkAdventure",
    "type": "module",
    "style": "dist/style.css",
    "exports": {
        ".": "./dist/style.css",
        "./style.css": "./dist/style.css",
        "./theme.css": "./src/theme.css",
        "./*": "./*"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "compile:base": "postcss --config src/base src/base/*.css --base src --dir dist/style --ext .css",
        "concat:base": "cat dist/style/base/*.css > dist/style/base.css",
        "build:base": "npm run compile:base && npm run concat:base",
        "compile:utilities": "postcss --config src/utilities src/utilities/*.css --base src --dir dist/style --ext .css",
        "concat:utilities": "cat dist/style/utilities/*.css > dist/style/utilities.css",
        "build:utilities": "npm run compile:utilities && npm run concat:utilities",
        "compile:components": "postcss --config src/components src/components/*.css --base src --dir dist/style --ext .css",
        "concat:components": "cat dist/style/components/*.css > dist/style/components.css",
        "build:components": "npm run compile:components && npm run concat:components",
        "compile:style": "postcss --config src/components src/index.css -o dist/style.css",
        "build:style": "npm run build:base && npm run build:utilities && npm run build:components && npm run compile:style",
        "build": "npm run clean && npm run build:style",
        "watch": "chokidar \"src/**/*.css\" -c \"npm run build:style\"",
        "dev": "npm run build:style && npm run watch & cd example && npm run dev",
        "precommit": "lint-staged",
        "prepare": "husky install"
    },
    "author": "WorkAdventure",
    "repository": {
        "type": "git",
        "url": "https://github.com/workadventure/design-system"
    },
    "license": "MIT",
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "chokidar-cli": "^3.0.0",
        "eslint": "^8.48.0",
        "eslint-config-prettier": "^9.0.0",
        "husky": "^8.0.3",
        "lint-staged": "^14.0.1",
        "postcss": "^8.4.29",
        "postcss-cli": "^10.1.0",
        "postcss-inline-svg": "^6.0.0",
        "prettier": "^3.0.3",
        "release-please": "^15.13.0"
    },
    "dependencies": {
        "@fontsource-variable/oswald": "^5.2.8",
        "@fontsource/roboto": "^4.5.8",
        "@fontsource/roboto-condensed": "^4.5.9",
        "tailwindcss": "^4.3.0"
    },
    "files": [
        "dist/**/*",
        "src/theme.css"
    ],
    "lint-staged": {
        "*.js": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
