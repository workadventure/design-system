{
    "name": "@workadventure/design-system",
    "version": "2.0.4",
    "description": "Tailwind Theme for WorkAdventure",
    "type": "module",
    "style": "dist/style.css",
    "exports": {
        ".": "./dist/style.css",
        "./style.css": "./dist/style.css",
        "./theme.css": "./src/theme.css",
        "./*": "./*"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build:style": "vite build",
        "build": "npm run clean && npm run build:style",
        "watch": "vite build --watch",
        "dev": "npm run build:style && npm run watch & cd example && npm run dev",
        "precommit": "lint-staged",
        "prepare": "husky"
    },
    "author": "WorkAdventure",
    "repository": {
        "type": "git",
        "url": "https://github.com/workadventure/design-system"
    },
    "license": "MIT",
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.3",
        "release-please": "^17.8.0",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@fontsource-variable/oswald": "^5.2.8",
        "@fontsource/roboto": "^5.2.10",
        "@fontsource/roboto-condensed": "^5.2.8",
        "tailwindcss": "^4.3.0"
    },
    "files": [
        "dist/**/*",
        "src/theme.css"
    ],
    "lint-staged": {
        "*.js": [
            "prettier --write"
        ]
    }
}
