{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",

        "types": ["node"],

        "declaration": true,
        "sourceMap": true,
        "inlineSources": true,
        "outDir": "dist",

        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitAny": false,

        "skipLibCheck": true,

        "rootDir": "src",
    },
    "include": ["./src/**/*"],
    "exclude": ["node_modules", "dist"]
}
